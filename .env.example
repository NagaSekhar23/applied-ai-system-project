# Copy to .env and fill in real values. .env is git-ignored; never commit it.
# Every variable is optional: with none set, the app runs in mock mode with no
# API key, no network calls and no cost.

# --- LLM provider ------------------------------------------------------------
# mock      deterministic local stand-in (default). No key needed.
# anthropic the real Claude API. Requires ANTHROPIC_API_KEY.
LLM_PROVIDER=mock

# Model id, used only when LLM_PROVIDER=anthropic.
LLM_MODEL=claude-opus-5-5

# Your Anthropic API key. Never commit this value.
# ANTHROPIC_API_KEY=sk-ant-replace-me

# --- Reliability -------------------------------------------------------------
# Seconds before a provider request is abandoned.
LLM_TIMEOUT_SECONDS=20

# Extra attempts after the first. 0 disables retrying.
LLM_MAX_RETRIES=2

# Output token cap per request.
LLM_MAX_TOKENS=1024

# Reasoning effort: low | medium | high | xhigh | max.
# Hints are a simple task, so low is the default.
LLM_EFFORT=low

# --- Application -------------------------------------------------------------
# true shows the Developer Debug Info panel, including the secret number.
GAME_DEBUG=false

LOG_LEVEL=INFO
